DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/jobagent
JWT_SECRET=change-me
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173

# mock = no model calls (deterministic templates). anthropic needs a key.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# console = emails are written to the server log, nothing leaves the machine. smtp sends for real.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
